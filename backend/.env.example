# Copy to .env and fill in one provider key. Never commit .env — it is gitignored.
#
# Which model powers the agent is deployment configuration, not code: set the
# provider and model here rather than changing langchain_service.py.

# --- the provider key. One of these is enough. -------------------------------
groq_api_key=
# openai_api_key=
# anthropic_api_key=
# google_api_key=

# --- which model to use ------------------------------------------------------
# Defaults, used when these are left unset:
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Other combinations that work, given the matching key above:
#   LLM_PROVIDER=openai      LLM_MODEL=gpt-4o
#   LLM_PROVIDER=anthropic   LLM_MODEL=claude-sonnet-5-5
#   LLM_PROVIDER=google_genai LLM_MODEL=gemini-2.0-flash
#
# The agent has to choose tools and arguments from a schema it has never seen,
# so a small model will struggle with the mapping step in particular.
